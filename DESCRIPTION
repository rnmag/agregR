    purrr,
    readr,
    stringr,
    tidyselect,
    ggplot2,
    scales,
    lubridate,
    cli,
    ggdist,
    ragg,
    sysfonts,
    showtext,
    stringi
Suggests:
    bayesplot,
    cmdstanr (>= 0.5.0)
